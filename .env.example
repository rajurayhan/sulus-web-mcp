# HTTP team / agent server (npm run start:http)
# Production VPS: copy deploy/vps/env.production.example instead (see docs/DEPLOY.md)
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_PATH=/mcp
# Required in production. Clients send: Authorization: Bearer <secret>
MCP_SHARED_SECRET=generate-a-long-random-secret
# Comma-separated Host header values (recommended behind a domain)
# MCP_ALLOWED_HOSTS=browse.sulus.ai,localhost

# Browse policy
# Allow http:// in addition to https:// (local/dev only)
ALLOW_INSECURE_HTTP=false
# Optional comma-separated host allowlist (exact or *.example.com)
# ALLOW_HOSTS=
# Extra deny hosts (always combined with private/metadata blocks)
# DENY_HOSTS=

# Timeouts and capacity (keep under ai-phone-system's 60s tools/call timeout)
NAVIGATION_TIMEOUT_MS=25000
TOOL_TIMEOUT_MS=45000
BROWSER_MAX_CONCURRENT=3
RATE_LIMIT_PER_MINUTE=30
MAX_OUTPUT_CHARS=18000
