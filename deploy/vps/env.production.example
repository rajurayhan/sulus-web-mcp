# Production env for browse.sulus.ai (copy to repo-root .env on the VPS).
# MCP_PORT here is the *host* publish port. The container always listens on 3000.
# 3100 avoids colliding with MCPConnect dashboard on 127.0.0.1:3000.

MCP_HOST=0.0.0.0
MCP_PORT=3100
MCP_PATH=/mcp

# Required. Clients send: Authorization: Bearer <this value>
MCP_SHARED_SECRET=replace-with-a-long-random-secret

# Host header allowlist (nginx forwards Host: browse.sulus.ai)
MCP_ALLOWED_HOSTS=browse.sulus.ai

# Browse policy — keep HTTPS-only in production
ALLOW_INSECURE_HTTP=false
# ALLOW_HOSTS=
# DENY_HOSTS=

# Stay under ai-phone-system's 60s tools/call timeout
NAVIGATION_TIMEOUT_MS=25000
TOOL_TIMEOUT_MS=45000
BROWSER_MAX_CONCURRENT=3
RATE_LIMIT_PER_MINUTE=30
MAX_OUTPUT_CHARS=18000
