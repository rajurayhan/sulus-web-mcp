# Production env for browse.sulus.ai on the MiniERP droplet.
# Copy to /var/www/sulus-web-mcp/.env.production (chmod 600).
# Bind loopback only — nginx terminates TLS. Port 3100 avoids MiniERP on 3010.

NODE_ENV=production
MCP_HOST=127.0.0.1
MCP_PORT=3100
MCP_PATH=/mcp

# Required. Clients send: Authorization: Bearer <this value>
#   openssl rand -hex 32
MCP_SHARED_SECRET=replace-with-a-long-random-secret

MCP_ALLOWED_HOSTS=browse.sulus.ai

ALLOW_INSECURE_HTTP=false
# ALLOW_HOSTS=
# DENY_HOSTS=

NAVIGATION_TIMEOUT_MS=25000
TOOL_TIMEOUT_MS=45000
BROWSER_MAX_CONCURRENT=3
RATE_LIMIT_PER_MINUTE=30
MAX_OUTPUT_CHARS=18000

PLAYWRIGHT_BROWSERS_PATH=/var/www/sulus-web-mcp/.playwright
